// ATR-normalized momentum, Z-scored, optionally blended with an RSI-based
// range component via the Kaufman Efficiency Ratio. Uses ta.atr / ta.rsi
// (Wilder RMA) so results match the MQL4/MQL5 ports of this indicator
// bar-for-bar.
//@version=5
indicator("Adaptive Vol Momentum", overlay = false, precision = 3)

momLen    = input.int(14, "Momentum Period", minval = 1)
atrLen    = input.int(14, "ATR Period", minval = 1)
zLen      = input.int(100, "Z-Score Lookback", minval = 2)
useER     = input.bool(true, "Blend with Kaufman ER (design②)")
erLen     = input.int(14, "Efficiency Ratio Period", minval = 1)
rsiLen    = input.int(14, "RSI Period", minval = 1)
smoothLen = input.int(3, "Signal Smoothing (EMA)", minval = 1)
clipVal   = input.float(4.0, "Clip (+/-)", minval = 1.0)

// --- design①: ATR-normalized momentum, Z-scored over zLen ---
atrVal  = ta.atr(atrLen)
normMom = atrVal != 0 ? (close - close[momLen]) / atrVal : 0.0

meanNM  = ta.sma(normMom, zLen)
stdNM   = ta.stdev(normMom, zLen)
trendZ0 = stdNM != 0 ? (normMom - meanNM) / stdNM : 0.0
trendZ  = math.max(math.min(trendZ0, clipVal), -clipVal)

// --- range component: RSI recentred to the same +/-clipVal scale ---
rsiVal     = ta.rsi(close, rsiLen)
rangeComp0 = (rsiVal - 50.0) / 12.5
rangeComp  = math.max(math.min(rangeComp0, clipVal), -clipVal)

// --- design②: Kaufman efficiency ratio, 1 = pure trend, 0 = pure noise ---
direction  = math.abs(close - close[erLen])
volatility = math.sum(math.abs(close - close[1]), erLen)
er         = volatility != 0 ? direction / volatility : 0.0

final  = useER ? er * trendZ + (1 - er) * rangeComp : trendZ
signal = ta.ema(final, smoothLen)

plot(final,  "AdaptiveVolMomentum", color = color.new(#1e88e5, 0), linewidth = 2)
plot(signal, "Signal", color = color.new(#b0bec5, 0))
hline(2.0, "OB", color = color.gray, linestyle = hline.style_dotted)
hline(-2.0, "OS", color = color.gray, linestyle = hline.style_dotted)
hline(0.0, "Mid", color = color.gray, linestyle = hline.style_dotted)
